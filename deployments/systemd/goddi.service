[Unit]
Description=GoDDI - Enterprise DDI Platform
Documentation=https://github.com/jincaiw/GoDDI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=goddi
Group=goddi
ExecStart=/usr/local/bin/goddi serve --config /etc/goddi/config.yaml
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

# Security hardening
NoNewPrivileges=true
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/goddi /var/log/goddi

# Environment
EnvironmentFile=-/etc/goddi/goddi.env
Environment=GODDI_LOG_LEVEL=info
Environment=GODDI_SERVER_DATA_DIR=/var/lib/goddi
Environment=GODDI_DATABASE_DSN=/var/lib/goddi/goddi.db

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=goddi

[Install]
WantedBy=multi-user.target
